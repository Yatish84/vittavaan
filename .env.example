APP_ENV=local
APP_RELEASE_ID=development
PUBLIC_WEB_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:8000/api/v1
AUTH_CORE_WEB_URL=http://localhost:3000
AUTH_CORE_API_URL=http://localhost:8001
AUTH_CORE_VERIFIER_URL=http://localhost:8081
AUTH_RETURN_URL=http://localhost:5173/auth/return
AUTH_VERIFIER_TIMEOUT_SECONDS=2
AUTH_ALLOWED_CLIENT_TYPES=["WEB"]
AUTH_CORE_HANDOFF_CLIENT_SECRET_FILE=/run/secrets/auth_core_handoff_client_secret
DATABASE_URL_FILE=/run/secrets/database_url
REDIS_URL_FILE=/run/secrets/redis_url
OTEL_EXPORTER_ENDPOINT=
